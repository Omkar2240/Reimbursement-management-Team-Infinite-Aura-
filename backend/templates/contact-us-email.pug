doctype html
html(lang='en')
  head
    title #{title}
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500&display=swap' rel='stylesheet')
    style.
      .main-content {
        padding: 40px;
        background-color: #f4f7fc;
      }
      .card {
        border-radius: 12px;
        background-color: white;
        padding: 30px;
        text-align: left;
        box-shadow: 0px 8px 0px 0px #e8eaef;
      }
      .label {
        font-weight: 600;
        color: #333;
      }
      .value {
        margin: 4px 0 16px;
        color: #444;
      }
  body(style='margin: 0;background-color: #F9FAFC;padding: 28px;font: 14px / 20px "Lexend", sans-serif;')
    include ./header
    table(align='center' cellpadding='0' cellspacing='0' width='100%' style='background: white;max-width:660px;margin-top:30px;border:1px solid #D7DAE0;border-radius: 12px; ')
      tr
        td(align='center' valign='top' style='padding:40px 0px;')
          div.card
            p(style='font-size:14px;color: #4d4d4d;margin: 0px 0px 16px;line-height:16px')
              | #{mailMessage.line1}
            p(style='font-size:14px;color: #4d4d4d;margin: 0px 0px 24px;line-height:16px')
              | #{mailMessage.line2}
            p.label Name:
            p.value #{contactDetails.name}
            p.label Email:
            p.value #{contactDetails.email}
            p.label Phone:
            p.value #{contactDetails.phone}
            p.label Subject:
            p.value #{contactDetails.subject}
            p.label Message:
            p.value #{contactDetails.message}
    include ./footer
