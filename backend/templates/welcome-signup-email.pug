doctype html
html(lang='en')
  head
    title #{title}
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500&display=swap' rel='stylesheet')
    link(href="https://fonts.googleapis.com/icon?family=Material+Icons" rel='stylesheet')
    style.
      .main-content {
        max-width: inherit;
        padding: 40px;
        background-color: #f4f7fc;
      }
      .welcome-card{
        border-radius: 12px;
        background-color:white;
        padding: 30px;
        text-align:center;
        box-shadow:0px 8px 0px 0px #e8eaef;
      }
      .cta-button {
        display: inline-block;
        background-color: #007bff;
        color: white;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
        margin: 20px 0;
      }
      .user-info {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin: 20px 0;
        border-left: 4px solid #007bff;
      }
  body(style='margin: 0;background-color: #F9FAFC;padding: 28px;font: 14px / 20px "Lexend", sans-serif;')
    include ./header
    table(align='center' border='0' cellpadding='0' cellspacing='0' width='100%' style='background: white;max-width:660px;margin-top:30px;border:1px solid #D7DAE0;border-radius: 12px; ')
      tr
        td(align='center' valign='top' style='padding:40px 20px;')
          div.welcome-card
            // Welcome icon or emoji
            div(style='font-size: 48px; margin-bottom: 20px;') 🎉
            
            h1(style='color: #333; font-size: 24px; margin-bottom: 10px; font-weight: 500;') 
              | #{mailMessage.line1}
            
            p(style='font-size:16px;color: #666;font-weight:400;margin: 15px 0;line-height:24px')
              | #{mailMessage.line2}
            
            p(style='font-size:14px;color: #666;font-weight:400;margin: 10px 0;line-height:20px')
              | #{mailMessage.line3}
            
            // User details section
            div.user-info(style='text-align: left; margin: 25px 0;')
              h3(style='color: #333; font-size: 16px; margin-bottom: 10px;') Account Details:
              p(style='margin: 5px 0; color: #666;')
                strong Name: 
                | #{userDetails.name}
              p(style='margin: 5px 0; color: #666;')
                strong Email: 
                | #{userDetails.email}
              p(style='margin: 5px 0; color: #666;')
                strong Join Date: 
                | #{userDetails.joinDate}
            
            p(style='font-size:16px;color: #333;font-weight:500;margin: 20px 0;line-height:24px')
              | #{mailMessage.line4}
            
            // Call to action button
            a.cta-button(href=dashboardUrl style='display: inline-block; background-color: #007bff; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 500; margin: 20px 0;')
              | Access Your Dashboard
            
            // Additional help section
            div(style='margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;')
              p(style='font-size:12px;color: #999;margin: 5px 0;line-height:18px')
                | Need help getting started? Contact our support team or visit our help center.
              p(style='font-size:12px;color: #999;margin: 5px 0;line-height:18px')
                | Happy learning! 📚
    include ./footer